{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/pkirsanov/bubbles/schemas/execution-control-event.schema.json",
  "title": "Bubbles execution-control event v2",
  "description": "Draft-07 validates the portable event shape and eventType/supersedesEventId dependency. The execution-control-store.py runtime validator is normative for canonical bytes, duplicate extension namespaces, calendar-valid timestamps, content addresses, chain identity, and correction/supersession lineage constraints that Draft-07 cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractType",
    "schemaVersion",
    "sequence",
    "eventType",
    "eventId",
    "transactionId",
    "previousEventDigest",
    "eventDigest",
    "recordedAt",
    "occurrenceId",
    "attemptId",
    "posture",
    "subject",
    "objectDigest",
    "supersedesEventId",
    "extensions"
  ],
  "allOf": [
    {
      "if": { "properties": { "eventType": { "const": "RECORD" } }, "required": ["eventType"] },
      "then": { "properties": { "supersedesEventId": { "type": "null" } } },
      "else": { "properties": { "supersedesEventId": { "type": "string", "pattern": "^evt:[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128 } } }
    }
  ],
  "properties": {
    "contractType": { "const": "execution-control-event" },
    "schemaVersion": { "const": 2 },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "eventType": { "enum": ["RECORD", "CORRECT", "SUPERSEDE"] },
    "eventId": { "type": "string", "pattern": "^evt:[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128 },
    "transactionId": { "type": "string", "pattern": "^txn:sha256:[a-f0-9]{64}$" },
    "previousEventDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "eventDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "recordedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "occurrenceId": { "type": "string", "pattern": "^occ:[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128 },
    "attemptId": { "type": "string", "pattern": "^att:[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128 },
    "posture": { "enum": ["off", "shadow", "reference-enforce", "unsupported"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "pattern": "^(command|phase|run|stage|budget|session|x\\.[a-z0-9]+(\\.[a-z0-9][a-z0-9-]*){2,})$", "maxLength": 128 },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 128 }
      }
    },
    "objectDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "supersedesEventId": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^evt:[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128 }
      ]
    },
    "extensions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "schemaVersion", "payloadDigest"],
        "properties": {
          "namespace": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*){2,}$", "maxLength": 128 },
          "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "payloadDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    }
  }
}
