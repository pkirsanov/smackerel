# Per-machine operator overlay. Copy this file to `.smackerel.local.env`
# (gitignored) and fill in the values for THIS machine. Every key below is
# REQUIRED — `./smackerel.sh config generate` aborts fail-loud when one is
# missing (smackerel-no-defaults: no silent fallback, ever).
#
# smackerel.sh sources this file with `set -a` before any subcommand runs, so
# the values reach scripts/commands/config.sh as exported env vars.

# ─────────────────────────────────────────────────────────────────────
# SMACKEREL_OLLAMA_URL (REQUIRED) — base URL of the Ollama daemon this
# machine talks to. Missing/empty aborts with [F-OLLAMA-URL-MISSING].
#
# EVERY environment (dev included) targets the operator's SHARED HOST Ollama
# daemon, which carries the approved min-set:
#   qwen3:30b-a3b     generalist / reasoning / fast
#   qwen3-coder:30b   code generation
#   gemma4:26b        vision / multimodal + tool-calling
#   deepseek-ocr:3b   OCR
#   nomic-embed-text  embeddings
#
# The real address is per-operator deployment topology and is deliberately
# NOT committed anywhere in this repo (product-deployment-boundary). It lives
# here for dev, and comes from the deploy adapter's app.env injection for
# production-class targets.
#
#   SMACKEREL_OLLAMA_URL=http://<your-ollama-host>:<port>
SMACKEREL_OLLAMA_URL=

# ─────────────────────────────────────────────────────────────────────
# Spec 061 SCOPE-06c — per-machine hardware-tier override (REQUIRED).
# `./smackerel.sh config generate` aborts fail-loud with
# [F061-HARDWARE-TIER-MISSING] if SMACKEREL_HARDWARE_TIER is unset, and with
# [F061-HARDWARE-TIER-INVALID] if it is neither cpu nor accel.
#
# Allowed values:
#   SMACKEREL_HARDWARE_TIER=cpu     # commodity host (no local GPU/NPU)
#   SMACKEREL_HARDWARE_TIER=accel   # ROCm / CUDA / NPU-capable host
#
# NOTE (2026-07-30, approved-min-set directive): the tier no longer selects a
# MODEL SIZE. Both tiers resolve to the same approved min-set model, because
# both issue against the same shared host daemon. What the tier still
# expresses is the latency budget of the machine making the request. See
# config/smackerel.yaml::models.tiers and design.md §5.1.
SMACKEREL_HARDWARE_TIER=
